[Unit]
Description=statusd - vaertsstatus som JSON til mkstartside (apps-mk)
After=network.target

[Service]
# Kilden ligger i mkstartside-repoet, ikke løst i /opt. Så følger den med
# `git pull` som resten af appen, og der er kun ét sted at rette den.
ExecStart=/usr/bin/python3 /srv/apps/mkstartside/statusd/statusd.py
Restart=on-failure
RestartSec=5

# De tjenester startsiden viser en prik for. Listen står her og ikke i koden,
# så statusd.py forbliver den samme fil på alle værter.
Environment=STATUSD_UNITS=nginx,flask_dnd,have_inbox,mkstartside

# Denne agent er den eneste der bruger `systemctl is-active`, og derfor den
# eneste der IKKE kan køre med DynamicUser=yes: en dynamisk UID findes ikke i
# /etc/passwd, dbus-daemon kan ikke slå den op, og enhver forespørgsel dør med
# "Transport endpoint is not connected" — hvorefter alle tjenester ser ud til at
# være nede. En rigtig systembruger uden hjemmemappe og uden login giver det
# samme lave privilegie-niveau, men kan tale med systemd:
#
#     useradd --system --no-create-home --shell /usr/sbin/nologin statusd
#
User=statusd
# Repo-mappen er 750 apps:apps, så statusd kan ikke traversere ind og læse sin
# egen kildefil uden dette. Gruppen apps har r-x hele vejen, så det ene tilvalg
# er nok. Alternativet — User=apps — ville give statusd læseadgang til ALLE
# app-data, og det har den intet brug for.
SupplementaryGroups=apps

[Install]
WantedBy=multi-user.target
