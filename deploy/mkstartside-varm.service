[Unit]
Description=Hold mkstartsides cache varm
# Siden viser udløbne data med det samme og henter nye i baggrunden (se
# kilder/cache.py) — men kun op til en grænse pr. kilde (status: 3 minutter).
# Er data ældre, venter visningen. Uden et kald med jævne mellemrum ville
# første visning efter en pause altså stadig vente 3-4 sekunder. Dette kald
# hvert minut sætter baggrundshentningen i gang, så grænsen aldrig nås, og
# så det er timeren og ikke et menneske, der venter.
After=mkstartside.service
Requires=mkstartside.service

[Service]
Type=oneshot
DynamicUser=yes
ExecStart=/usr/bin/curl -sS -o /dev/null --max-time 30 http://127.0.0.1:8765/
